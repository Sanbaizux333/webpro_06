<!Doctype html>
<html>
<head>
    <meta charset="utf-8">
    <title>篠澤広のデータベース</title>
</head>
<body>
    <h2>篠澤広が関連するカードの詳細</h2>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>カードジャンル</th>
                <th>タイプ・プラン</th>
                <th>カード名</th>
            </tr>
        </thead>
        <tbody>
            <% for( let row of data ) { %>
            <tr>
                <td><%= row.id %></td>
                <td><%= row.genre%></td>
                <td><%= row.type %></td>
                <td><%= row.name %></td>
            </tr>
            <% } %>
        </tbody>
    </table>

    <p><a href="/public/hiro_add.html">登録用ページに戻る</a></p>
</body>
</html>